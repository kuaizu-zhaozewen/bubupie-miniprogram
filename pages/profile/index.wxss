.mine-page { background:#f5f5f7; color:#1d1d1f; }.profile { padding:32rpx 32rpx 40rpx; }.profile-head { display:flex; align-items:center; gap:25rpx; width:100%; padding:25rpx 0 44rpx; text-align:left; }.profile-avatar { width:112rpx; height:112rpx; flex-shrink:0; border-radius:50%; }.profile-copy { flex:1; min-width:0; }.profile-copy .section-title { font-size:40rpx; }.profile-copy .subtitle { font-size:22rpx; margin-top:12rpx; }.profile-group { background:#fff; border-radius:28rpx; padding:0 28rpx; margin-bottom:22rpx; }.profile-row { display:flex; align-items:center; justify-content:space-between; width:100%; min-height:116rpx; gap:16rpx; border-bottom:1rpx solid #eeeeef; text-align:left; font-size:27rpx; padding:24rpx 0; }.profile-row:last-child { border-bottom:0; }.profile-note { display:block; color:#86868b; font-size:21rpx; margin-top:9rpx; }.profile-value { color:#86868b; font-size:23rpx; }.profile-chevron { color:#a1a1a6; font-size:34rpx; }.profile-footnote { color:#a1a1a6; font-size:21rpx; text-align:center; padding-top:35rpx; }
