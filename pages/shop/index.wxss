.shop-page { min-height:100vh; background:#f5f5f7; color:#1d1d1f; padding-bottom:calc(60rpx + env(safe-area-inset-bottom)); }.shop-content { padding:12rpx 32rpx 0; }.store-toolbar { height:82rpx; display:flex; justify-content:space-between; align-items:center; }.store-logo { width:160rpx; height:54rpx; }.bag-link { display:flex; gap:10rpx; align-items:center; font-size:23rpx; }.bag-link text:not(.small-arrow) { background:#1d1d1f; color:#fff; border-radius:50%; min-width:34rpx; height:34rpx; line-height:34rpx; font-size:20rpx; }.small-arrow { font-size:29rpx; margin-left:4rpx; }.store-heading { margin-top:40rpx; font-size:59rpx; line-height:1.15; letter-spacing:-2rpx; font-weight:700; }.store-subtitle { color:#86868b; margin-top:15rpx; font-size:29rpx; }.search-box { margin-top:38rpx; height:92rpx; padding:0 20rpx; display:flex; align-items:center; gap:12rpx; background:#e8e8ed; border-radius:22rpx; }.search-symbol { font-size:42rpx; color:#6e6e73; padding-bottom:5rpx; }.search-box input { flex:1; width:0; min-width:0; height:90rpx; font-size:23rpx; }.search-submit { font-size:24rpx; color:#0066cc; flex-shrink:0; padding:12rpx 0 12rpx 8rpx; }.clear-search { color:#86868b; font-size:31rpx; width:30rpx; flex-shrink:0; }.coupon-entry { width:100%; display:flex; justify-content:space-between; align-items:center; gap:16rpx; text-align:left; padding:28rpx 8rpx; border-bottom:1rpx solid #dedee2; }.coupon-entry-title { display:block; font-size:25rpx; font-weight:600; }.coupon-entry-note { display:block; font-size:21rpx; color:#86868b; margin-top:8rpx; }.blue-arrow { font-size:36rpx; color:#06c; }.category-heading { display:flex; align-items:center; justify-content:space-between; padding:36rpx 0 22rpx; font-size:29rpx; font-weight:600; }.all-categories { color:#6e6e73; font-size:22rpx; font-weight:400; }.all-categories.active { color:#06c; }.category-grid { display:grid; grid-template-columns:1fr 1fr; gap:16rpx; }.category-card { display:flex; align-items:center; gap:12rpx; background:#fff; border:2rpx solid transparent; border-radius:24rpx; padding:20rpx 12rpx; text-align:left; min-width:0; }.category-card.selected { border-color:#0071e3; }.category-card image { width:82rpx; height:86rpx; flex-shrink:0; }.category-name { display:block; font-size:25rpx; font-weight:600; }.category-subtitle { display:block; color:#86868b; font-size:18rpx; line-height:1.4; margin-top:8rpx; }.section-heading { display:flex; align-items:center; justify-content:space-between; margin:42rpx 0 24rpx; }.section-heading view { font-size:38rpx; font-weight:700; letter-spacing:-1rpx; }.section-heading text { color:#86868b; font-size:22rpx; }.product-grid { display:grid; grid-template-columns:1fr 1fr; gap:20rpx; }.product-card { background:#fff; border-radius:30rpx; overflow:hidden; text-align:left; display:flex; flex-direction:column; min-width:0; }.product-image-wrap { padding:16rpx 12rpx 0; width:100%; height:310rpx; display:flex; align-items:center; justify-content:center; }.product-image-wrap image { width:100%; height:100%; }.product-card-copy { padding:18rpx 22rpx 26rpx; display:flex; flex-direction:column; flex:1; }.product-badge { font-size:18rpx; color:#a25e2f; margin-bottom:9rpx; }.product-title { font-size:27rpx; font-weight:600; line-height:1.35; letter-spacing:-.4rpx; }.product-subtitle { font-size:20rpx; line-height:1.65; color:#86868b; margin-top:12rpx; }.product-more { font-size:21rpx; color:#06c; margin-top:auto; padding-top:22rpx; }.product-more text { margin-left:5rpx; }.store-footer { text-align:center; padding:46rpx 12rpx 8rpx; font-size:19rpx; line-height:1.7; color:#86868b; }.store-footer button { display:block; width:100%; padding:16rpx; color:#6e6e73; font-size:21rpx; }.search-empty { padding:72rpx 22rpx; text-align:center; }.search-empty view { font-size:31rpx; font-weight:600; }.search-empty text { display:block; color:#86868b; font-size:24rpx; margin-top:20rpx; }.search-empty button { color:#06c; margin-top:30rpx; font-size:25rpx; }.search-notice { margin-top:24rpx; background:#e7f0e9; border-radius:22rpx; padding:26rpx; }.notice-title { font-size:26rpx; font-weight:600; }.notice-description { color:#5e7363; font-size:22rpx; line-height:1.6; margin-top:12rpx; }.search-notice button { color:#06c; font-size:23rpx; margin-top:18rpx; text-align:left; }
