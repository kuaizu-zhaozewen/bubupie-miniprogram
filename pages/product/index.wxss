.product-page { min-height:100vh; padding-bottom:calc(180rpx + env(safe-area-inset-bottom)); background:#fff; color:#1d1d1f; }.detail-intro { text-align:center; padding:42rpx 32rpx 25rpx; }.detail-badge { color:#a25e2f; font-size:22rpx; }.detail-title { font-size:49rpx; font-weight:700; letter-spacing:-1.5rpx; line-height:1.2; margin-top:16rpx; }.detail-subtitle { color:#86868b; font-size:26rpx; margin-top:18rpx; line-height:1.6; }.detail-hero { height:630rpx; margin:20rpx 32rpx 0; background:#f5f5f7; border-radius:32rpx; padding:28rpx; }.detail-hero image { width:100%; height:100%; }.detail-content { padding:48rpx 40rpx 20rpx; }.price-label { font-size:21rpx; color:#86868b; }.detail-price { font-size:53rpx; font-weight:600; margin-top:10rpx; letter-spacing:-1rpx; }.detail-description { font-size:27rpx; line-height:1.9; margin-top:30rpx; }.highlights { padding:26rpx 0; border-bottom:1rpx solid #e5e5e7; }.highlights view { display:flex; gap:15rpx; font-size:24rpx; line-height:1.7; padding:12rpx 0; color:#6e6e73; }.highlights text { color:#86868b; flex-shrink:0; }.quantity-row { display:flex; align-items:center; justify-content:space-between; padding:28rpx 0; font-size:26rpx; }.quantity-picker { display:flex; align-items:center; gap:30rpx; }.quantity-picker button { width:58rpx; height:58rpx; line-height:58rpx; border-radius:50%; background:#f5f5f7; font-size:29rpx; }.detail-note { color:#86868b; font-size:21rpx; line-height:1.7; margin-top:15rpx; }.detail-bottom { position:fixed; z-index:15; left:0; right:0; bottom:0; max-width:860rpx; margin:auto; padding:24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom)); display:flex; gap:20rpx; background:rgba(255,255,255,.97); border-top:1rpx solid #e5e5e7; }.detail-bottom button { height:90rpx; border-radius:48rpx; font-size:27rpx; display:flex; align-items:center; justify-content:center; }.view-bag { flex:1; color:#06c; background:#f5f5f7; }.add-to-bag { flex:1.45; color:#fff; background:#0071e3; }
