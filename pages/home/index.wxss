.home { background:#f5f5f7; color:#1d1d1f; }.home .content { padding:14rpx 32rpx 35rpx; }.brand-row { display:flex; align-items:center; justify-content:space-between; padding:14rpx 0 25rpx; gap:20rpx; }.brand { width:178rpx; height:62rpx; }.brand-row text { color:#a1a1a6; font-size:20rpx; }.heading { margin-top:44rpx; margin-bottom:24rpx; display:flex; align-items:center; justify-content:space-between; }.home-title { font-size:34rpx; font-weight:650; }.edit { color:#06c; font-size:25rpx; padding:12rpx 0 12rpx 24rpx; }.grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:22rpx; }.ip-card { width:100%; height:510rpx; border-radius:32rpx; background:white; padding:28rpx 24rpx 22rpx; overflow:hidden; text-align:left; }.card-name,.card-sub { display:block; }.card-name { font-size:31rpx; font-weight:650; }.card-sub { margin-top:10rpx; color:#8a8a87; font-size:20rpx; }.card-image { display:block; width:100%; height:330rpx; margin-top:12rpx; }.card-action { display:flex; justify-content:space-between; color:#86868b; font-size:20rpx; margin-top:14rpx; }.collection-note { color:#a1a1a6; font-size:21rpx; padding:29rpx 0 14rpx; }.companions-empty { background:#fff; border-radius:30rpx; padding:45rpx 30rpx; }.companions-empty view { font-size:28rpx; font-weight:600; }.companions-empty text { display:block; color:#86868b; font-size:23rpx; margin-top:14rpx; line-height:1.7; }.companions-empty button { color:#06c; font-size:25rpx; margin-top:24rpx; text-align:left; }.ip-card:active,.suggestion-card:active { opacity:.75; }
