<view class="page"><view class="content edit-profile"><button class="avatar-edit" bindtap="avatar"><image src="/assets/edit-circle.svg" /><text>更换头像</text></button><view class="field"><text class="label">昵称</text><input class="input-box" maxlength="20" placeholder="你的昵称" value="{{nickname}}" bindinput="nickname" /></view><view class="field"><text class="label">生日（选填）</text><picker mode="date" value="{{birthday}}" end="{{today}}" bindchange="birthday"><view class="input-box" style="line-height:104rpx;">{{birthday || '选择生日'}}</view></picker><button wx:if="{{birthday}}" bindtap="clearBirthday" class="footnote">清除生日</button><view class="footnote">用于生日月礼遇展示，可随时删除。</view></view><view class="field"><text class="label">简介</text><textarea class="bio" maxlength="80" placeholder="介绍一下自己" value="{{bio}}" bindinput="bio" /></view><button class="primary-button save" bindtap="save">保存</button><view class="footnote local">资料仅保存在本机演示缓存中。</view></view></view>
