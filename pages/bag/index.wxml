<view class="bag-page"><view class="bag-title">你的购物袋。</view><view class="bag-subtitle">{{totals.count ? '喜欢的好物，都在这里。' : '给下一件喜欢，留个位置。'}}</view><view wx:if="{{notice}}" class="bag-notice">{{notice}}</view>
  <view wx:for="{{items}}" wx:key="productId" class="bag-item"><image src="{{item.image}}" mode="aspectFit" /><view class="bag-item-copy"><view class="bag-item-name">{{item.name}}</view><view class="bag-item-price">¥{{item.amount}}</view><view class="bag-item-actions"><view class="bag-stepper"><button data-id="{{item.productId}}" data-delta="-1" bindtap="quantity" aria-label="减少商品数量">−</button><text>{{item.quantity}}</text><button data-id="{{item.productId}}" data-delta="1" bindtap="quantity" aria-label="增加商品数量">＋</button></view><button class="remove" data-id="{{item.productId}}" bindtap="remove">移除</button></view></view></view>
  <view wx:if="{{totals.count}}" class="bag-summary"><view class="summary-row"><text>商品小计</text><text>¥{{totals.original}}</text></view><view class="summary-row"><button class="coupon-choice" bindtap="toggleCoupon">{{useCoupon ? '☑' : '□'}} {{coupon ? '使用¥' + coupon.amount + '优惠券' : '暂无可用优惠券'}}</button><text>−¥{{totals.discount}}</text></view><button class="coupon-link" bindtap="coupons">查看我的优惠券 ›</button><view class="summary-total"><text>合计</text><text>¥{{totals.payable}}</text></view><button class="checkout-button" bindtap="checkout">确认模拟订单</button><text class="bag-note">演示价格与流程 · 不产生真实交易</text></view>
  <view wx:else class="bag-empty"><view class="empty-bag-icon">♡</view><button class="shop-button" bindtap="shop">继续逛好物</button></view>
  <button class="orders-toggle" bindtap="toggleOrders">我的演示订单 · {{orders.length}} <text>{{showOrders ? '−' : '＋'}}</text></button><view wx:if="{{showOrders}}"><view wx:if="{{!orders.length}}" class="bag-note">还没有演示订单。</view><view wx:for="{{orders}}" wx:key="id" class="order"><view class="summary-row"><text>{{item.id}}</text><text>{{item.statusText}}</text></view><view class="order-note">商品 ¥{{item.amount}} · 优惠 ¥{{item.discountText}} · 实付 ¥{{item.paidText}}</view><view class="order-actions"><button wx:if="{{item.status === 'paid'}}" data-id="{{item.id}}" data-action="receive" bindtap="progress">模拟确认收货</button><button wx:if="{{item.status === 'received'}}" data-id="{{item.id}}" data-action="afterSale" bindtap="progress">模拟售后期结束</button><button wx:if="{{item.status !== 'refunded'}}" data-id="{{item.id}}" bindtap="refund">模拟退款</button></view></view></view>
</view>
