.bag-page { min-height:100vh; background:#fff; padding:42rpx 36rpx calc(70rpx + env(safe-area-inset-bottom)); color:#1d1d1f; }.bag-title { font-size:56rpx; font-weight:700; letter-spacing:-2rpx; }.bag-subtitle { color:#86868b; font-size:27rpx; margin:16rpx 0 38rpx; }.bag-item { display:flex; gap:26rpx; padding:30rpx 0; border-bottom:1rpx solid #e5e5e7; }.bag-item image { width:190rpx; height:210rpx; border-radius:24rpx; background:#f5f5f7; flex-shrink:0; }.bag-item-copy { flex:1; min-width:0; padding-top:8rpx; }.bag-item-name { font-size:29rpx; font-weight:600; line-height:1.5; }.bag-item-price { font-size:25rpx; margin-top:14rpx; }.bag-item-actions { display:flex; justify-content:space-between; align-items:center; margin-top:20rpx; gap:15rpx; }.bag-stepper { display:flex; align-items:center; gap:22rpx; font-size:24rpx; }.bag-stepper button { width:46rpx; height:46rpx; line-height:46rpx; border-radius:50%; background:#f5f5f7; }.remove { color:#06c; font-size:22rpx; }.bag-summary { margin-top:36rpx; }.summary-row { display:flex; justify-content:space-between; gap:18rpx; margin-bottom:24rpx; font-size:25rpx; }.coupon-choice,.coupon-link { color:#06c; font-size:24rpx; }.coupon-link { display:block; margin:8rpx 0 30rpx; }.summary-total { border-top:1rpx solid #e5e5e7; padding-top:30rpx; margin-bottom:30rpx; display:flex; justify-content:space-between; font-size:37rpx; font-weight:600; }.checkout-button,.shop-button { background:#0071e3; color:white; border-radius:48rpx; padding:26rpx; font-size:27rpx; width:100%; }.bag-note { display:block; font-size:21rpx; color:#86868b; line-height:1.7; text-align:center; margin:22rpx 0; }.bag-empty { padding:20rpx 0 40rpx; }.empty-bag-icon { font-size:100rpx; color:#b5b5b9; text-align:center; margin-bottom:35rpx; }.orders-toggle { display:flex; justify-content:space-between; width:100%; border-top:1rpx solid #e5e5e7; padding:34rpx 0 10rpx; margin-top:45rpx; font-size:27rpx; }.order { background:#f5f5f7; border-radius:25rpx; padding:25rpx; margin-top:22rpx; }.order-note { font-size:22rpx; line-height:1.7; color:#86868b; }.order-actions { display:flex; flex-wrap:wrap; gap:20rpx; margin-top:22rpx; }.order-actions button { color:#06c; font-size:23rpx; }.bag-notice { background:#e7f0e9; border-radius:20rpx; padding:25rpx; font-size:25rpx; margin-bottom:20rpx; }
