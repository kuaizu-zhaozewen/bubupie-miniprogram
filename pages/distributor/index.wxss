.distributor { padding-top:36rpx; }.title { margin:16rpx 0; font-size:40rpx; }.channel,.ledger { padding:30rpx; margin-top:28rpx; }.channel .footnote { margin:16rpx 0 26rpx; }.text-action { display:block; width:100%; text-align:center; padding:24rpx 0; font-size:24rpx; color:#746c60; }.stats { display:grid; grid-template-columns:1fr 1fr; gap:18rpx; margin-top:26rpx; }.stat { padding:28rpx 22rpx; }.stat text { color:#827b72; font-size:23rpx; }.stat view { margin-top:12rpx; font-size:34rpx; font-weight:600; }.ledger .row { font-size:24rpx; margin-bottom:25rpx; gap:20rpx; }.rule { padding:28rpx 0 40rpx; font-size:23rpx; color:#827b72; line-height:1.8; }.qr-card { text-align:center; }.qr-card image { width:340rpx; height:340rpx; }.order { padding:28rpx; margin-top:18rpx; font-size:25rpx; }.order .footnote { margin:14rpx 0; }

