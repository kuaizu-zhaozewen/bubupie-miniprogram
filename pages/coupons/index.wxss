.coupons-page { min-height:100vh; background:#f5f5f7; color:#1d1d1f; padding:46rpx 32rpx calc(60rpx + env(safe-area-inset-bottom)); }.wallet-title { font-size:55rpx; font-weight:700; letter-spacing:-2rpx; line-height:1.22; }.wallet-subtitle { font-size:23rpx; color:#86868b; line-height:1.7; margin-top:20rpx; }.coupon-tabs { display:flex; border-bottom:1rpx solid #dedee2; margin:35rpx 0; }.coupon-tabs button { flex:1; padding:26rpx 4rpx; font-size:25rpx; color:#86868b; border-bottom:4rpx solid transparent; }.coupon-tabs button.selected { color:#1d1d1f; font-weight:600; border-color:#1d1d1f; }.coupon-tabs text { margin-left:10rpx; font-size:21rpx; font-weight:400; }.wallet-coupon { position:relative; display:flex; align-items:center; flex-wrap:wrap; gap:18rpx; padding:38rpx 27rpx 27rpx; background:#fff; border-radius:28rpx; margin-bottom:24rpx; }.coupon-value { font-size:62rpx; font-weight:600; letter-spacing:-2rpx; color:#06c; min-width:160rpx; }.coupon-value text { font-size:30rpx; margin-right:5rpx; }.coupon-information { flex:1; min-width:0; }.coupon-title { font-size:29rpx; font-weight:600; }.coupon-source { font-size:21rpx; color:#86868b; line-height:1.6; margin-top:12rpx; }.coupon-expiry { font-size:19rpx; color:#86868b; line-height:1.5; margin-top:6rpx; }.coupon-state { position:absolute; top:16rpx; right:22rpx; color:#86868b; font-size:18rpx; }.use-coupon { width:100%; padding-top:24rpx; margin-top:10rpx; border-top:1rpx dashed #ddd; text-align:right; font-size:24rpx; color:#06c; }.inactive .coupon-value { color:#a1a1a6; }.inactive { opacity:.8; }.coupon-empty { text-align:center; padding:35rpx 20rpx 65rpx; }.gift-symbol { color:#a1a1a6; font-size:90rpx; margin-bottom:30rpx; }.coupon-empty view:not(.gift-symbol) { font-size:30rpx; font-weight:600; }.coupon-empty text { display:block; color:#86868b; font-size:24rpx; line-height:1.8; margin-top:20rpx; }.coupon-empty button { color:#06c; font-size:25rpx; margin-top:30rpx; }.wallet-note { color:#86868b; font-size:21rpx; line-height:1.8; padding:18rpx 12rpx; }
