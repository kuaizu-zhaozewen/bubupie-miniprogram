page { height:100%; overflow:hidden; }.chat-page { height:100vh; display:flex; flex-direction:column; overflow:hidden; background:#f5f5f7; color:#1d1d1f; }.chat-status { flex-shrink:0; display:flex; align-items:center; gap:10rpx; padding:22rpx 28rpx 20rpx; font-size:22rpx; color:#86868b; border-bottom:1rpx solid #e8e8ed; }.status-dot { width:10rpx; height:10rpx; border-radius:50%; background:#73a886; }.status-date { margin-left:auto; font-size:20rpx; }.messages { flex:1; height:0; min-height:0; width:100%; }.messages-content { padding:30rpx 24rpx 20rpx; }.message-row { display:flex; align-items:flex-start; gap:16rpx; width:100%; margin-bottom:30rpx; }.message-row.user { justify-content:flex-end; }.chat-avatar { width:84rpx; height:84rpx; flex:0 0 84rpx; border-radius:50%; background:#e8e8ed; overflow:hidden; object-fit:cover; }.message-column { max-width:calc(100% - 100rpx); min-width:0; }.message-author { display:block; font-size:20rpx; line-height:1.4; color:#86868b; margin:1rpx 0 11rpx 9rpx; }.user .message-author { text-align:right; margin-right:9rpx; }.bubble { max-width:100%; border-radius:8rpx 28rpx 28rpx 28rpx; padding:24rpx 27rpx; background:#fff; color:#1d1d1f; font-size:28rpx; line-height:1.8; white-space:pre-wrap; word-break:break-word; overflow-wrap:anywhere; }.user .bubble { border-radius:28rpx 8rpx 28rpx 28rpx; background:#e1edfa; }.quick-prompts { margin:5rpx 0 36rpx 100rpx; }.prompt-title { color:#86868b; font-size:21rpx; margin-bottom:16rpx; }.prompt { display:flex; justify-content:space-between; gap:18rpx; align-items:center; width:100%; text-align:left; padding:23rpx 24rpx; border-radius:21rpx; border:1rpx solid #e2e2e7; background:#f0f0f4; font-size:24rpx; line-height:1.6; margin-bottom:13rpx; }.prompt-arrow { color:#06c; font-size:27rpx; flex-shrink:0; }.composer-area { flex-shrink:0; padding:18rpx 24rpx calc(14rpx + env(safe-area-inset-bottom)); border-top:1rpx solid #e5e5e7; background:rgba(250,250,252,.98); }.composer { display:flex; align-items:center; gap:14rpx; background:#fff; border:1rpx solid #dedee3; border-radius:48rpx; padding:10rpx 10rpx 10rpx 25rpx; }.composer input { flex:1; width:0; min-width:0; height:66rpx; font-size:27rpx; }.composer button { flex:0 0 66rpx; width:66rpx; height:66rpx; line-height:66rpx; text-align:center; border-radius:50%; background:#0071e3; color:white; font-size:36rpx; }.composer button[disabled] { background:#d6d6dc; color:white; }.chat-demo-note { text-align:center; color:#a1a1a6; font-size:18rpx; padding-top:12rpx; }.chat-end { height:8rpx; }
