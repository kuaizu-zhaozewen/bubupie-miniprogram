.card-page .content { padding: 16rpx 40rpx 0; }.test-panel { padding:22rpx; margin-bottom:30rpx; }.test-title { font-size:21rpx; color:#777; margin-bottom:14rpx; }.switch-row { display:flex; gap:12rpx; margin-top:12rpx; }.chip { flex:1; padding:16rpx; border-radius:16rpx; background:#f2f1ee; font-size:22rpx; }.chip.selected { background:#293f3e; color:white; }.card-meta image { width:126rpx; height:48rpx; }.card-meta text { font-size:21rpx; color:#87827c; }.card-hero { display:block; width:100%; height:440rpx; margin:18rpx 0 6rpx; }.message-card { padding:38rpx 34rpx; }.message-label { font-size:23rpx; color:#8f8075; }.quote { font-size:43rpx; font-weight:600; line-height:1.6; margin-top:25rpx; white-space:pre-line; letter-spacing:-1rpx; }.message-note { font-size:24rpx; color:#87827c; line-height:1.7; margin-top:26rpx; }.card-sign { font-size:21rpx; color:#aa9583; margin-top:30rpx; }.birthday { text-align:center; color:#8a827a; font-size:21rpx; padding:27rpx 0; }.share-actions { display:flex; gap:12rpx; margin-top:24rpx; }.share-actions button { flex:1; background:rgba(255,255,255,.75); border-radius:22rpx; padding:24rpx 6rpx; font-size:23rpx; }.share-actions button[disabled] { opacity:.45; }.card-note { text-align:center; margin-top:24rpx; }.retry { font-size:22rpx; color:#766588; padding:22rpx; }.poster-overlay { position:fixed; inset:0; z-index:50; background:rgba(0,0,0,.7); display:flex; align-items:center; justify-content:center; }.poster-sheet { width:85%; background:#fff; padding:22rpx; border-radius:28rpx; }.poster-image { width:100%; height:62vh; display:block; margin-bottom:20rpx; }.close { width:100%; padding:22rpx; font-size:24rpx; }
