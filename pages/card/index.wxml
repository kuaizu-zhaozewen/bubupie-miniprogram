<view class="page card-page" style="background: {{daily.color}};">
  <view class="content">
    <view wx:if="{{testing}}" class="test-panel surface"><view class="test-title">靠一靠测试 · 仅本页模拟身份</view><view class="switch-row"><button class="chip {{!owner ? 'selected' : ''}}" data-value="guest" bindtap="setRole">访客</button><button class="chip {{owner ? 'selected' : ''}}" data-value="owner" bindtap="setRole">已领养</button></view><view class="switch-row"><button class="chip {{daily.mood === 'low' ? 'selected' : ''}}" data-value="low" bindtap="setMood">低落 · 安慰</button><button class="chip {{daily.mood === 'high' ? 'selected' : ''}}" data-value="high" bindtap="setMood">开心 · 同玩</button></view></view>
    <view class="card-meta row"><image src="/assets/bubupie-wordmark.png" mode="aspectFit" /><text>{{daily.date}}</text></view>
    <view class="card-scene"><image wx:if="{{item.id === 'star'}}" class="card-scenery" src="/assets/quanzhou-gucuo-lines.png" mode="aspectFit" aria-hidden="true" /><image class="card-hero" src="{{item.image}}" mode="aspectFit" /></view>
    <view class="message-card surface"><view class="message-label">{{item.name}}给我的一句话</view><view class="quote">{{daily.quote}}</view><view class="message-note">{{daily.note}}</view><view class="card-sign">海风轻轻，湾月陪你。</view></view>
    <view class="birthday">{{item.name}}的生日 · {{item.birthday || '生日待公布'}}</view>
    <button wx:if="{{owner}}" class="primary-button" bindtap="fortune">查看湾月今天的完整运势 ›</button><button wx:if="{{!owner}}" class="primary-button" bindtap="bind">领养湾月，加入我的橱窗 ›</button>
    <view class="share-actions"><button open-type="share">分享小程序</button><button bindtap="timelineHelp">朋友圈</button><button bindtap="poster" disabled="{{posterBusy}}">{{posterBusy ? '生成中…' : '生成海报'}}</button></view>
    <button wx:if="{{!shareImage}}" disabled="{{busy}}" class="retry" bindtap="renderImages">重试生成分享图片</button><view class="footnote card-note">基于 IP 今日状态的角色创作 · 仅供娱乐<br/>当前为演示数据，非个人命运预测</view>
  </view>
  <view wx:if="{{poster}}" class="poster-overlay"><view class="poster-sheet"><image class="poster-image" src="{{poster}}" mode="aspectFit" /><button class="primary-button" bindtap="imageMenu">保存 / 分享海报</button><button class="close" bindtap="closePoster">返回卡片</button></view></view>
  <canvas canvas-id="shareCover" style="position:fixed;left:-3000px;top:0;width:600px;height:480px;" />
  <canvas canvas-id="shareTimeline" style="position:fixed;left:-3000px;top:0;width:600px;height:600px;" />
  <canvas canvas-id="sharePoster" style="position:fixed;left:-3000px;top:0;width:750px;height:1120px;" />
</view>

