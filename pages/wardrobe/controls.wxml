<view class="inline-wardrobe">
  <view class="look-text">{{selectionText}}</view>
  <view class="wardrobe-bar"><view><text class="section-title">给{{item.name}}换装</text><text class="owned-count">已绑定 {{ownedCount}} 件</text></view><button class="bind-toggle" bindtap="toggleBind">{{showBindPanel ? '收起绑定' : '绑定新衣装 ＋'}}</button></view>
  <view class="slot-tabs"><button wx:for="{{slots}}" wx:key="id" class="slot {{activeSlot === item.id ? 'active' : ''}}" data-slot="{{item.id}}" bindtap="selectSlot">{{item.name}}</button></view>
  <view class="pieces"><button class="piece {{item.selected ? 'selected' : ''}} {{item.owned ? '' : 'locked'}}" wx:for="{{rows}}" wx:key="id" data-id="{{item.id}}" bindtap="choose"><view class="piece-image"><image src="{{item.thumb}}" mode="aspectFit" /><text class="piece-status">{{item.status}}</text></view><view class="piece-name">{{item.name}}</view><view class="piece-state">{{item.selected ? '正在穿戴 ✓' : item.owned ? '点选穿上' : '绑定后解锁'}}</view></button></view>
  <button class="remove-button" bindtap="remove">取下当前{{activeSlot === 'top' ? '上衣' : activeSlot === 'bottom' ? '下装' : activeSlot === 'shoes' ? '鞋履' : '头饰'}}</button>
  <view class="outfits"><button wx:for="{{outfitRows}}" wx:key="id" data-id="{{item.id}}" bindtap="outfit"><text>{{item.name}}</text><text class="outfit-state">{{item.status}} · {{item.ready ? '一键穿戴' : '待绑定'}}</text></button></view>
  <view wx:if="{{showBindPanel}}" class="bind-panel"><view class="section-title">新衣装，扫码收进来</view><view class="subtitle">绑定后可反复搭配，不会改变本体领养状态。</view><button class="primary-button scan-button" bindtap="scan" disabled="{{!enabled}}">扫描衣装二维码</button><view class="code-input-row"><input value="{{code}}" bindinput="input" maxlength="512" placeholder="或输入衣装绑定码" /><button bindtap="bind" disabled="{{!enabled}}">绑定</button></view></view>
  <view wx:if="{{enabled}}"><button class="demo-tools-toggle" bindtap="toggleDemoTools">{{showDemoTools ? '收起演示工具' : '展开演示工具'}} ›</button><view wx:if="{{showDemoTools}}" class="demo-panel"><view class="demo-label">本机演示工具 · 不是真实商品权益</view><view class="account-row"><button class="{{account === 'demo-a' ? 'active' : ''}}" data-account="demo-a" bindtap="account">演示账号 A</button><button class="{{account === 'demo-b' ? 'active' : ''}}" data-account="demo-b" bindtap="account">演示账号 B</button></view><view class="footnote">可测试重复扫码、跨账号抢绑、单件绑定与混搭。公开演示码不用于生产包装。</view><button class="code-toggle" bindtap="toggleCodes">{{showCodes ? '收起演示二维码' : '查看套装 / 单件演示二维码'}} ›</button><view wx:if="{{showCodes}}" class="demo-codes"><view wx:for="{{codes}}" wx:key="code" class="demo-code"><image src="{{item.qr}}" mode="aspectFit" data-url="{{item.qr}}" bindtap="previewCode" /><view><view class="piece-name">{{item.name}}</view><view class="footnote code-label">{{item.code}}</view><button class="fill-code" data-code="{{item.code}}" bindtap="useCode">填入此码</button></view></view></view><button class="reset-button" bindtap="reset">重置本机衣橱演示</button></view></view>
  <view wx:else class="footnote wardrobe-unavailable">衣装服务尚未接入。真实版本将由服务器核销独立绑定码并保存账号衣橱。</view>
</view>
