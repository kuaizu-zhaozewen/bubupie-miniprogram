.wardrobe { background:#fbf8f3; }.wardrobe-content{padding:12rpx 40rpx 60rpx}.brand-line{display:flex;justify-content:space-between;align-items:center;color:#bb2726;font-size:24rpx;font-weight:700;margin-bottom:24rpx}.edition{font-weight:400;color:#8d8279;font-size:21rpx}.wardrobe .title{font-size:43rpx}.stage{height:650rpx;position:relative;margin-top:26rpx;overflow:hidden;border-radius:36rpx;background:#eee9df}.stage-arch{position:absolute;top:68rpx;left:100rpx;right:100rpx;bottom:70rpx;background:#faf6ee;border-radius:230rpx 230rpx 12rpx 12rpx}.stage-caption{position:absolute;top:26rpx;left:0;right:0;text-align:center;font-size:18rpx;letter-spacing:4rpx;color:#8a7e72}.doll{position:absolute;left:50%;transform:translateX(-50%);top:66rpx;width:480rpx;height:545rpx;z-index:2}.layer{position:absolute;inset:0;width:100%;height:100%}.stage-shadow{position:absolute;bottom:68rpx;left:190rpx;right:190rpx;height:24rpx;background:#cec4b4;border-radius:50%;filter:blur(10rpx)}.stage-note{position:absolute;bottom:20rpx;left:0;right:0;text-align:center;font-size:18rpx;color:#8e8177}.look-text{font-size:21rpx;line-height:1.7;color:#80756c;padding:18rpx 4rpx 30rpx}.wardrobe-bar{display:flex;justify-content:space-between;align-items:center}.owned-count{font-size:22rpx;color:#908476}.slot-tabs{display:flex;border-bottom:1rpx solid #ded7cd;margin-top:26rpx}.slot{flex:1;text-align:center;padding:18rpx 0;color:#968779;font-size:25rpx}.slot.active{border-bottom:4rpx solid #ba2424;font-weight:700;color:#a91c1e}.pieces{display:flex;gap:14rpx;margin-top:24rpx;align-items:stretch}.piece{width:calc((100% - 28rpx)/3);border:2rpx solid transparent;border-radius:22rpx;text-align:left;overflow:hidden;padding:10rpx;background:white}.piece.selected{border-color:#ae2523}.piece-image{height:160rpx;position:relative;background:#f3f0e9;border-radius:14rpx;overflow:hidden}.piece-image image{width:100%;height:100%;transform:scale(1.75);transform-origin:50% 72%}.piece-status{position:absolute;right:8rpx;top:7rpx;background:#fffdf8dc;color:#9a6e51;font-size:17rpx;padding:3rpx 7rpx;border-radius:7rpx}.piece-name{font-size:22rpx;font-weight:600;line-height:1.5;margin-top:12rpx}.piece-state{font-size:19rpx;color:#aa2726;margin:8rpx 0 4rpx}.locked .piece-state{color:#a39587}.remove-button{font-size:22rpx;color:#8b7e70;text-align:right;padding:22rpx 0}.outfits-title{margin-top:20rpx}.outfits{margin:22rpx 0 32rpx}.outfits button{display:flex;justify-content:space-between;border-bottom:1rpx solid #e5ded4;padding:23rpx 4rpx;font-size:24rpx}.outfit-state{font-size:20rpx;color:#998576}.bind-panel{background:white;padding:28rpx;border-radius:26rpx;margin-top:20rpx}.bind-panel .subtitle{font-size:22rpx;margin-top:10rpx}.scan-button{margin-top:24rpx;background:#b42525;height:86rpx}.code-input-row{display:flex;border:1rpx solid #e7e0d6;border-radius:14rpx;margin-top:20rpx;padding:12rpx;gap:12rpx}.code-input-row input{flex:1;min-width:0;font-size:22rpx;height:52rpx}.code-input-row button{font-size:23rpx;color:#af2024;padding:8rpx 12rpx}.demo-panel{margin-top:30rpx;padding:26rpx;background:#f0ebe3;border-radius:24rpx}.demo-label{font-size:22rpx;font-weight:600;color:#8c6b53}.account-row{display:flex;gap:16rpx;margin:22rpx 0}.account-row button{padding:12rpx 20rpx;border:1rpx solid #d6c9b7;border-radius:12rpx;font-size:22rpx}.account-row .active{color:#a62222;border-color:#a62222;background:white}.code-toggle{font-size:23rpx;padding:22rpx 0;text-align:left;color:#885b45}.demo-code{display:flex;gap:16rpx;padding:18rpx 0;border-top:1rpx solid #ded5c8}.demo-code image{width:130rpx;height:130rpx;flex-shrink:0}.code-label{word-break:break-all}.fill-code{font-size:21rpx;text-align:left;color:#a82724;margin-top:9rpx}.reset-button{font-size:21rpx;text-align:left;color:#9a8c80;margin-top:24rpx}
.outfits button,.remove-button,.code-toggle,.reset-button{display:block;width:100%}.outfits button{display:flex;align-items:center;text-align:left;gap:16rpx}.outfit-state{flex-shrink:0}.code-toggle,.reset-button{text-align:left}
