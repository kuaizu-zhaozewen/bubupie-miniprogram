@import "../wardrobe/index.wxss";
.character { padding-top: 18rpx; }.name { margin-top: 8rpx; }.hero { height: 400rpx; margin-top: 20rpx; display: flex; justify-content: center; position: relative; overflow:hidden; border-radius:30rpx; background:#f1ede6; }.hero-image { position: relative; z-index: 1; width: 100%; height: 368rpx; }.hero-shadow { position: absolute; bottom: 32rpx; width: 48%; height: 38rpx; border-radius: 50%; background: radial-gradient(ellipse, rgba(42, 37, 53, .14) 0%, rgba(42, 37, 53, 0) 72%); }.fortune-entry { width: 100%; padding: 34rpx 38rpx; margin-top: 36rpx; text-align: left; }.sparkle { color: #6e6399; font-size: 40rpx; }.entry-copy { flex: 1; margin-left: 26rpx; }.entry-title { font-size: 29rpx; font-weight: 700; }.entry-sub { font-size: 23rpx; color: #808082; margin-top: 14rpx; }.records { margin: 48rpx 0 28rpx; }.all { font-size: 23rpx; }.record { display: flex; width: 100%; text-align: left; padding: 36rpx 0; gap: 64rpx; font-size: 26rpx; }.record-date { font-size: 23rpx; }.chat-link { text-align: left; padding-top: 28rpx; font-size: 25rpx; }

/* Quanzhou scenery stays behind the character and never receives taps. */
.gucuo-lines { position: absolute; z-index: 0; left: -24rpx; top: 24rpx; width: calc(100% + 48rpx); height: 348rpx; opacity: 0.15; pointer-events: none; }
.hero-shadow { z-index: 1; }
.hero-image { z-index: 2; }
.character-heading { display:flex; align-items:center; justify-content:space-between; gap:20rpx; }
.character-description { display:flex; flex-direction:column; gap:10rpx; max-width:64%; min-width:0; text-align:right; color:#8b8177; font-size:21rpx; }
.hero-caption { position:absolute; left:0; right:0; bottom:12rpx; font-size:18rpx; text-align:center; color:#8d8174; z-index:3; }
.character .look-text { padding:14rpx 0 22rpx; font-size:19rpx; }
.character .wardrobe-bar { gap:10rpx; }
.character .wardrobe-bar > view { display:flex; flex-wrap:wrap; align-items:center; gap:4rpx 12rpx; min-width:0; }
.character .section-title { font-size:28rpx; }
.character .owned-count { font-size:20rpx; }
.bind-toggle { padding:13rpx 17rpx; border-radius:20rpx; background:#eee7dc; font-size:21rpx; color:#946348; flex-shrink:0; }
.character .slot-tabs { margin-top:16rpx; }
.character .slot { padding:16rpx 0; font-size:24rpx; }
.character .pieces { margin-top:18rpx; gap:12rpx; }
.character .piece { width:calc((100% - 24rpx)/3); padding:8rpx; }
.character .piece-image { height:120rpx; }
.character .piece-name { font-size:21rpx; margin-top:8rpx; }
.character .piece-state { font-size:18rpx; }
.character .remove-button { padding:16rpx 0; font-size:20rpx; }
.character .outfits { margin:0 0 16rpx; }
.character .outfits button { padding:19rpx 4rpx; font-size:23rpx; }
.demo-tools-toggle { padding:16rpx 0; color:#9a8c80; font-size:19rpx; text-align:left; }
.character .demo-panel { margin-top:8rpx; }
.wardrobe-unavailable { margin:18rpx 0; }
