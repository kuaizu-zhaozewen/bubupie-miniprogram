.fortune { padding: 12rpx 32rpx 0; }.meta { color:#83837e; font-size:22rpx; padding:0 10rpx; }.daily-label { background:#edede8; padding:9rpx 16rpx; border-radius:20rpx; font-size:19rpx; }.character-stage { position:relative; height:530rpx; display:flex; justify-content:center; align-items:center; }.stage-halo { position:absolute; width:460rpx; height:460rpx; border-radius:50%; background:radial-gradient(circle, #f2e7dd 0%, rgba(247,247,246,0) 70%); }.daily-character { position:relative; width:480rpx; height:480rpx; z-index:1; }.stage-caption { position:absolute; bottom:0; font-size:20rpx; color:#8c8279; letter-spacing:2rpx; }
.greeting { margin:24rpx 0 20rpx; padding:28rpx 30rpx; }.greeting-title,.greeting-copy { display:block; }.greeting-title { font-size:30rpx; font-weight:600; }.greeting-copy { font-size:23rpx; color:#85817a; margin-top:12rpx; line-height:1.65; }
.summary-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:20rpx; }.summary-card { width:100%; padding:28rpx; min-height:310rpx; text-align:left; }.card-label { font-size:26rpx; font-weight:600; }.card-chevron { font-size:34rpx; color:#aaa9a3; }.score-ring { width:184rpx; height:184rpx; margin:24rpx auto 0; border:12rpx solid #e5d6ca; border-right-color:#f3efea; border-radius:50%; display:flex; align-items:center; justify-content:center; transform:rotate(-22deg); }.ring-center { display:flex; flex-direction:column; align-items:center; transform:rotate(22deg); }.score { font-size:59rpx; line-height:1.1; font-weight:600; letter-spacing:-2rpx; }.ring-label { font-size:19rpx; color:#99938b; margin-top:8rpx; }.mood-mark,.mood-title,.mood-copy { display:block; }.mood-mark { font-size:62rpx; line-height:1.2; color:#c4a17e; margin-top:30rpx; }.mood-title { font-size:27rpx; margin-top:20rpx; font-weight:500; }.mood-copy { font-size:21rpx; color:#95908a; margin-top:12rpx; }
.dimensions,.lucky-panel { padding:30rpx; margin-top:20rpx; }.quiet-label { font-size:20rpx; color:#99948e; }.stat-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:28rpx 36rpx; margin-top:30rpx; }.stat { font-size:22rpx; color:#85817a; }.stat-value { color:#393733; font-size:24rpx; }.stat-track { height:8rpx; background:#f1eeea; border-radius:8rpx; margin-top:16rpx; overflow:hidden; }.stat-fill { height:100%; background:#c9b29c; border-radius:8rpx; }.lucky-grid { display:grid; grid-template-columns:repeat(3,1fr); margin-top:28rpx; text-align:center; }.lucky-grid>view { display:flex; flex-direction:column; align-items:center; }.lucky-grid>view+view { border-left:1rpx solid #f0efec; }.color-dot { display:block; width:30rpx; height:30rpx; border-radius:50%; background:#d7988b; margin:5rpx 0; }.lucky-symbol { font-size:34rpx; height:40rpx; line-height:40rpx; color:#9d8874; }.lucky-value { font-size:23rpx; margin-top:14rpx; }.lucky-label { color:#99948e; font-size:19rpx; margin-top:8rpx; }
.record-entry { width:100%; margin-top:20rpx; padding:30rpx; text-align:left; }.record-copy { display:block; font-size:22rpx; color:#99948e; margin-top:12rpx; }.chat-button { margin-top:28rpx; gap:18rpx; height:92rpx; }.note { text-align:center; margin:28rpx 0 0; font-size:19rpx; }.summary-card:active,.record-entry:active { opacity:.7; }
.fortune .character-stage { width:100%; height:558rpx; padding:0; border:0; margin:0; text-align:center; }
.fortune .stage-caption { bottom:30rpx; }
.stage-hint { position:absolute; left:0; right:0; bottom:0; color:#8c8279; font-size:19rpx; }
.fortune .daily-character { margin-bottom:32rpx; }

/* IP-specific suggestions belong only to the detail page. */
.suggestion-heading { color:#86868b; font-size:22rpx; margin:24rpx 0 17rpx; }.suggestion-card { display:flex; width:100%; border-radius:30rpx; background:#fff; align-items:center; gap:15rpx; text-align:left; overflow:hidden; }.suggestion-copy { flex:1; min-width:0; }.featured { padding:32rpx 26rpx 30rpx 30rpx; min-height:246rpx; }.featured image { width:175rpx; height:180rpx; flex-shrink:0; }.suggestion-label { display:block; color:#8f7560; font-size:20rpx; margin-bottom:12rpx; }.suggestion-title { display:block; font-size:31rpx; line-height:1.45; font-weight:600; letter-spacing:-.5rpx; }.suggestion-note { display:block; color:#86868b; font-size:21rpx; margin-top:12rpx; line-height:1.6; }.suggestion-action { display:block; color:#06c; font-size:22rpx; margin-top:23rpx; }.suggestion-action text { margin-left:10rpx; }.compact { margin-top:16rpx; padding:22rpx 25rpx 22rpx 29rpx; }.compact .suggestion-label { font-size:18rpx; margin-bottom:7rpx; }.compact .suggestion-title { font-size:24rpx; }.compact image { width:72rpx; height:84rpx; }.suggestion-chevron { color:#a1a1a6; font-size:32rpx; flex-shrink:0; }
.suggestions { margin-bottom:24rpx; }.suggestion-heading { margin-top:30rpx; }
