<view class="page"><view class="content fortune">
  <view class="meta row"><text>{{date}}</text><text class="daily-label">今日陪伴</text></view>
  <button class="character-stage" bindtap="dress" aria-label="点击{{item.name}}形象换装"><view class="stage-halo"></view><image wx:if="{{item.id === 'star' ? quanzhouScene : false}}" class="fortune-scenery" src="/assets/quanzhou-gucuo-lines.png" mode="aspectFit" aria-hidden="true" /><dress-avatar wx:if="{{hasDress}}" class="daily-character" layers="{{dressLayers}}" /><image wx:else class="daily-character" src="{{item.image}}" mode="aspectFit" /><view class="stage-caption">{{item.name}} · {{item.birthday || '生日待公布'}}</view><text class="stage-hint">点击形象，给{{item.name}}换装</text></button>
  <view class="greeting surface"><text class="greeting-title">{{daily.label}}</text><text class="greeting-copy">{{daily.action}}</text></view>
  <view class="suggestion-heading">给{{item.name}}的小建议</view>
  <view class="suggestions"><button wx:for="{{suggestions}}" wx:key="id" class="suggestion-card {{index === 0 ? 'featured' : 'compact'}}" data-id="{{item.id}}" bindtap="recommendation" aria-label="{{item.title}} 查看商城推荐"><view class="suggestion-copy"><text class="suggestion-label">{{item.label}}</text><text class="suggestion-title">{{item.title}}</text><text wx:if="{{index === 0}}" class="suggestion-note">{{item.note}}</text><text wx:if="{{index === 0}}" class="suggestion-action">挑件好物 <text>›</text></text></view><image src="{{item.image}}" mode="aspectFit" /><text wx:if="{{index !== 0}}" class="suggestion-chevron">›</text></button></view>
  <view class="summary-grid">
    <button class="surface summary-card" bindtap="details" aria-label="查看今日运势详情"><view class="row"><text class="card-label">今日运势</text><text class="card-chevron">›</text></view><view class="score-ring"><view class="ring-center"><text class="score">{{daily.score}}</text><text class="ring-label">{{daily.label}}</text></view></view></button>
    <button class="surface summary-card mood-card" bindtap="chat"><view class="row"><text class="card-label">湾月的心情</text><text class="card-chevron">›</text></view><text class="mood-mark">☀</text><text class="mood-title">{{daily.label}}</text><text class="mood-copy">聊聊今天的小事</text></button>
  </view>
  <view class="surface dimensions"><view class="row section-heading"><text class="card-label">今天的小灵感</text><text class="quiet-label">角色视角</text></view><view class="stat-grid"><view class="stat" wx:for="{{stats}}" wx:key="name"><view class="row"><text>{{item.name}}</text><text class="stat-value">{{item.value}}</text></view><view class="stat-track"><view class="stat-fill" style="width: {{item.value}}%;"></view></view></view></view></view>
  <view class="surface lucky-panel"><text class="card-label">幸运随身带</text><view class="lucky-grid"><view><text class="color-dot"></text><text class="lucky-value">珊瑚粉</text><text class="lucky-label">幸运色</text></view><view><text class="lucky-symbol">7</text><text class="lucky-value">一点小幸运</text><text class="lucky-label">幸运数字</text></view><view><text class="lucky-symbol">↗</text><text class="lucky-value">去吹吹风</text><text class="lucky-label">今日灵感</text></view></view></view>
  <button class="record-entry surface row" bindtap="records"><view><text class="card-label">湾月的生活记录</text><text class="record-copy">簪一朵花，把泉州带在身边。</text></view><text class="card-chevron">›</text></button>
  <button class="primary-button chat-button" bindtap="chat">和{{item.name}}聊聊 <text>↗</text></button>
  <view class="footnote note">角色创作 · 运势为固定演示内容<br/>仅供娱乐，不作为现实决策依据</view>
</view></view>
