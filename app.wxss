@import "styles/scenery.wxss";
page { min-height: 100%; background: #f7f7f6; color: #17171a; font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", sans-serif; font-size: 28rpx; }
view, text, image, button, input, textarea { box-sizing: border-box; }
button { padding: 0; margin: 0; background: transparent; border-radius: 0; color: inherit; line-height: inherit; font-size: inherit; }
button::after { border: 0; }
.page { min-height: 100vh; padding-bottom: calc(56rpx + env(safe-area-inset-bottom)); }
.content { padding: 0 48rpx; }
.muted { color: #808082; }
.eyebrow { color: #808082; font-size: 20rpx; letter-spacing: 0.5rpx; }
.title { font-size: 46rpx; font-weight: 700; line-height: 1.3; letter-spacing: -1rpx; }
.subtitle { color: #808082; font-size: 25rpx; line-height: 1.6; }
.section-title { font-size: 30rpx; font-weight: 700; }
.surface { background: #fff; border-radius: 34rpx; }
.row { display: flex; align-items: center; justify-content: space-between; }
.arrow { color: #858585; font-size: 38rpx; font-weight: 300; line-height: 1; }
.line { height: 1rpx; background: #e3e3e3; }
.primary-button { width: 100%; height: 94rpx; border-radius: 48rpx; background: #17171a; color: #fff; display: flex; justify-content: center; align-items: center; font-weight: 600; font-size: 27rpx; }
.text-link { color: #17171a; font-size: 25rpx; }
.footnote { color: #808082; font-size: 20rpx; line-height: 1.65; }
.input-box { background: #fff; border-radius: 22rpx; height: 104rpx; padding: 0 32rpx; font-size: 27rpx; }
.label { display: block; margin-bottom: 20rpx; color: #808082; font-size: 24rpx; }
.empty { padding: 60rpx 32rpx; color: #808082; font-size: 25rpx; text-align: center; }
